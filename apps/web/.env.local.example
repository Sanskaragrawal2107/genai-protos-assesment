# AI Recruiter OS — web environment (production only)
# Copy to .env.local and fill in real values. Never commit .env.local.

# Required: public origin of the FastAPI service.
# Local production-like test: http://localhost:8000
NEXT_PUBLIC_API_URL=https://api.example.com

# Required: Supabase project used for browser authentication.
# Only public values belong here — never the service-role key.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
