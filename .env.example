# ============================================================================
# AI Recruiter OS — API environment (production only)
#
# There is no demo mode, no SQLite fallback and no local identity. The API
# refuses to boot unless every required value below is present and valid.
# Copy to .env and fill in real values. Never commit .env.
#
# The web app has its own file: apps/web/.env.local
# (see apps/web/.env.local.example).
# ============================================================================

# ---------------------------------------------------------------- runtime ---
# Exact browser origin allowed by CORS. Use your deployed web origin in
# production. For a local production-like test use http://localhost:3000.
WEB_ORIGIN=https://app.example.com
LOG_LEVEL=INFO

# Shared secret for cron/worker -> API calls (Authorization: Bearer ...).
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set the SAME value as an Edge Function secret: supabase secrets set API_INTERNAL_TOKEN=...
API_INTERNAL_TOKEN=

# ---------------------------------------------------------------- database ---
# Supabase Postgres, asyncpg driver. Use the Supavisor SESSION pooler (port
# 5432) or a direct connection. If you must use the transaction pooler (6543),
# append ?prepared_statement_cache_size=0 to the URL.
# postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# ---------------------------------------------------------------- supabase ---
# Project Settings -> API
SUPABASE_URL=https://<project-ref>.supabase.co
# Server-only. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings -> API -> JWT Settings -> JWT Secret (legacy HS256 secret).
# Only needed for legacy HS256 tokens; ES256/RS256 tokens are verified via the
# project's JWKS endpoint, so new Supabase projects work without this value.
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=resumes

# --------------------------------------------------------------- llm (AI) ---
# Optional. Any OpenAI-compatible endpoint. Leave blank to use deterministic
# extraction and templated scoring/emails.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
# Reasoning budget for gpt-5*/o-series models (ignored elsewhere): minimal | low |
# medium | high. The provider default is very slow on gpt-5-nano (30s+ per chat
# turn planning step); "low" keeps the same tool choices at a fraction of the
# latency, and "minimal" is fastest. Leave blank to use the provider default.
LLM_REASONING_EFFORT=low

# --------------------------------------------------------------- composio ---
# Required for real Gmail ingestion/email, Microsoft Teams meetings and Google
# Meet. Auth configs are resolved from your Composio project, or created as
# Composio-managed configs on first connect — no auth-config IDs belong here.
# Toolkits used: gmail, microsoft_teams, googlecalendar, googlemeet.
COMPOSIO_API_KEY=
# Optional: pin a toolkit version, e.g. 20261029_00. Empty -> latest.
COMPOSIO_TOOLKIT_VERSION=
COMPOSIO_BASE_URL=https://backend.composio.dev
COMPOSIO_USER_PREFIX=airecruiter

# --------------------------------------------------------------- github -----
# Optional. Raises the anonymous rate limit from 60 to 5000 req/h.
GITHUB_TOKEN=

# ------------------------------------------------------------- leetcode -----
# Verification uses the public LeetCode GraphQL endpoint by default. The hosted
# MCP server below is an optional last resort: it is only tried when GraphQL is
# unavailable AND LEETCODE_MCP_FALLBACK=true. Server-side only; the bearer token
# must never reach the browser.
LEETCODE_MCP_URL=
LEETCODE_MCP_TOKEN=
LEETCODE_MCP_TIMEOUT_SECONDS=30
LEETCODE_MCP_FALLBACK=false

# ------------------------------------------------------------------ mcp -----
# FastMCP server (apps/mcp). Workspace is resolved server-side, never from model input.
# Pin MCP_WORKSPACE_ID for the hosted Composio proxy; MCP_USER_ID is the audit identity.
MCP_WORKSPACE_ID=
MCP_USER_ID=

# --------------------------------------------------------------- scheduler ---
# Tuning only. Scheduling itself runs through Supabase pg_cron -> Edge Functions.
SYNC_DEFAULT_INTERVAL_MINUTES=30
SYNC_MAX_ATTEMPTS=4
SYNC_OVERLAP_MINUTES=60
SYNC_MAX_RESUME_BYTES=10485760
DEFAULT_TIMEZONE=Asia/Kolkata
WORKING_HOURS_START=9
WORKING_HOURS_END=19
# The meeting provider is not an environment variable: it is a per-workspace
# setting (microsoft_teams | google_meet | none) chosen in
# Settings -> Integrations and overridable per interview.
